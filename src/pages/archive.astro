---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

// 按年份分组：文章多了以后按年翻比一条长列表舒服
const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.publishedAt.getFullYear());
  if (!byYear.has(year)) {
    byYear.set(year, []);
  }
  byYear.get(year)!.push(post);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="归档 · 廖呈睿" description="按时间排列的全部文章。">
  <section class="hero">
    <h1>归档</h1>
    <p>共 {posts.length} 篇。</p>
  </section>

  {
    [...byYear.entries()].map(([year, items]) => (
      <div class="year-group">
        <h2>{year}</h2>
        <ul class="post-list">
          {items.map((post) => (
            <li>
              <a href={`${base}/posts/${post.id}/`}>
                <span class="post-date">
                  {post.data.publishedAt.toLocaleDateString("zh-CN", {
                    month: "2-digit",
                    day: "2-digit",
                    timeZone: "Asia/Shanghai",
                  })}
                </span>
                <span>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Base>
